# Copy to .env and fill in. Never commit .env.
#
# Three distinct model families are required: frontier agent, OSS agent, and judge.
# The judge must not share a family with either agent (see PROJECT.md).

# --- Frontier agent: Gemini via Google, or Claude Sonnet via Anthropic ---
# Only the selected provider's key is needed. FRONTIER_PROVIDER and FRONTIER_MODEL are one
# setting in two variables and must change together: FRONTIER_MODEL is the selected provider's
# own id for the model. A Claude id left behind after switching to gemini is refused with a
# ConfigError naming both variables, so it cannot reach Google and come back as a 404.
# Keep the unused pair commented rather than deleted, so switching back is an edit to two
# adjacent lines. With FRONTIER_PROVIDER unset the code falls back to anthropic.
FRONTIER_PROVIDER=gemini
FRONTIER_MODEL=gemini-3.6-flash
# FRONTIER_PROVIDER=anthropic
# FRONTIER_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- OSS agent: Llama 3.1 8B Instant via a hosted provider (Groq/Together) ---
# Only the selected provider's key is needed. OSS_MODEL is that provider's own id for the
# model, so it changes with OSS_PROVIDER: on together, e.g. Qwen/Qwen2.5-7B-Instruct-Turbo.
GROQ_API_KEY=
TOGETHER_API_KEY=
OSS_PROVIDER=groq
OSS_MODEL=llama-3.1-8b-instant

# --- Judge: third model family, different from both agents ---
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o-2024-11-20

# --- Tools ---
# Web search provider key. Results are cached to disk for determinism.
TAVILY_API_KEY=
WEB_CACHE_DIR=.cache/web

# --- Retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KB_DIR=kb

# --- Determinism ---
# Agent runs are temperature 0. Do not raise this for graded runs.
AGENT_TEMPERATURE=0
JUDGE_TEMPERATURE=0

# --- Model response cache ---
# Provider responses are cached on disk, keyed by model + messages + parameters, so
# re-running an eval is free and reproduces exactly. Set AGENTSEVAL_NO_CACHE=1 (or pass
# --no-cache) to bypass it and call providers directly.
MODEL_CACHE_DIR=.cache/models
AGENTSEVAL_NO_CACHE=0

# --- Logging ---
RUNS_DIR=runs
